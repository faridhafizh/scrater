{
  "name": "scrater",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "bun run --cwd backend build && bun run --cwd frontend build",
    "start:backend": "bun run --cwd backend start:dev",
    "start:frontend": "bun run --cwd frontend dev",
    "test": "bun run --cwd backend test"
  }
}
